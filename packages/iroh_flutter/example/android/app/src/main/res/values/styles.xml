<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The Android Window uses this theme while the process starts,
         if the Dark Mode setting of the OS is off. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Show a splash screen on the activity. The Flutter engine removes it
             when it draws its first frame. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- The Android Window uses this theme after the process starts.
         This theme sets the color of the Android Window while your Flutter UI
         starts. It also sets the color behind your Flutter UI while the UI runs.

         Only V2 and later of the Flutter Android embedding use this theme. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
